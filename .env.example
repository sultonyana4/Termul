# The sole network and verified TermulInvoices deployment are pinned in source.
# Required for release builds. Use the existing public wallet-auth endpoint.
VITE_TERMUL_WALLET_API_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/termul-wallet-v1

# Optional release settings. Supply both together for an explicit policy.
# Vercel needs the same deployment-scoped values at build time and function runtime.
# TERMUL_RELEASE_FEE_BPS=0
# TERMUL_RELEASE_FEE_VERSION=1

# Optional server-only Circle services. Enable locally for reviewed mock fixtures.
# TERMUL_CIRCLE_RELEASE_UI=disabled
# TERMUL_CIRCLE_LOGIN_API=disabled
# TERMUL_CIRCLE_INITIALIZATION=disabled
# TERMUL_CIRCLE_ARC_SWAP=disabled
# TERMUL_CIRCLE_ARC_ANY_TOKEN=disabled
# Optional server-side LI.FI Partner Portal key for Circle Any Token quotes.
# TERMUL_CIRCLE_LIFI_API_KEY=
# Required for hosted Circle swap review and execution. Set only an approved USDC ceiling.
# TERMUL_CIRCLE_ARC_SWAP_MAX_NETWORK_FEE_USDC=
# TERMUL_CIRCLE_MANAGED_API=disabled
# TERMUL_CIRCLE_MANAGED_EXECUTION=disabled
# TERMUL_CIRCLE_APP_ID=replace_with_circle_app_id
# TERMUL_CIRCLE_API_KEY=replace_with_wallets_api_key
# Optional comma-separated email restriction. Leave unset or blank for public OTP when Circle login is enabled.
# TERMUL_CIRCLE_LOGIN_EMAIL_ALLOWLIST=
# TERMUL_CIRCLE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# TERMUL_CIRCLE_SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
# TERMUL_CIRCLE_RECONCILE_SECRET=replace_with_a_random_worker_secret
# TERMUL_CIRCLE_SESSION_KEY=replace_with_64_hex_characters

# Read-only workers for previously admitted Circle transfers. Cross-chain admission is disabled.
# TERMUL_CIRCLE_BRIDGE_RECONCILE=disabled
# TERMUL_CIRCLE_LIFI_RECONCILE=disabled
